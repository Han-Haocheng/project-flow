  "rules": [
    "owns = 独占写域：只有该模块（或框架维护者）改这些文件",
    "shared = 共享写域：其他模块只能改 sections 里登记的区段；越段即视为越界，需先改边界再动手",
    "tests = 测试归属：测试跟着被测模块走，不跟着目录走",
    "sections 的 from/to 是文件内一字不差的锚点行；verify 会检查锚点存在、唯一、顺序正确"
  ],
  "roles": {
    "tasks-owner": {
      "title": "任务域负责人",
      "semantics": "负责九阶段状态机与任务记录的合法迁移：任何写 stage 的路径都必须过同一处校验。",
      "modules": [
        "tasks"
      ]
    },
    "heartbeats-owner": {
      "title": "心跳域负责人",
      "semantics": "负责心跳存活判定口径：面板、任务活锁与 claims 的「活」都从这一处读。",
      "modules": [
        "heartbeats"
      ]
    },
    "store-owner": {
      "title": "存储域负责人",
      "semantics": "负责写盘原子性、文件锁与记录契约：CAS / 补偿不得绕过这一层。",
      "modules": [
        "store"
      ]
    },
    "docs-owner": {
      "title": "文档域负责人",
      "semantics": "负责契约正文、README 与技能文档的同一套口径，改一处必须同步另一处。",
      "modules": [
        "docs"
      ]
    }
  },
