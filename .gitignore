node_modules/
.selftest/.client-probe/
.selftest/.host-probe/
test/.tmp/

# 运行时产物：心跳 / 临时目录 / 会话工作树（本地、每会话变化）
.agents/*
# 台账入库：flow/ 只放契约与日志，其余记录目录与 flow 平级
!.agents/flow/
!.agents/tasks/
!.agents/decisions/
!.agents/gates/
!.agents/experiments/
!.agents/description/
# 锁与门禁运行记录不提交（避免每次运行产生提交噪音）
.agents/flow/.lock
.agents/flow/logs/
# 原子写/接管中间产物：进程在任何阶段崩溃都不该把它们带进仓库
*.tmp-*
.agents/flow/.lock.takeover-*

# 桌面端运行日志（本地）
dsh-desktop.log
