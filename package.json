{
  "name": "@local/project-flow",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Project flow panel (read-only, plus one-click init): experiment tree, tasks, gate log, subagent heartbeats and running output, driven by a per-project flow contract.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Han-Haocheng/project-flow.git"
  },
  "bin": {
    "flow": "./bin/flow.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CONTRACT.md",
    "lib/",
    "bin/",
    "test/",
    "skills/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
