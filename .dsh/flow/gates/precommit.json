{
  "id": "precommit",
  "title": "提交前暂存区检查",
  "phase": "commit",
  "enabled": true,
  "steps": [
    {
      "id": "whitespace",
      "run": "git diff --cached --check",
      "expect": "exit 0",
      "timeoutSeconds": 600
    },
    {
      "id": "decisions",
      "run": "\"./bin/flow.mjs\" check decisions",
      "expect": "exit 0",
      "timeoutSeconds": 600
    }
  ],
