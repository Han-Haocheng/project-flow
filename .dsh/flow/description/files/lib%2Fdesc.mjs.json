  "lines": 2125,
  "semantics": "lib/desc.mjs 是「项目描述台账」的模型层：只做纯计算与只读文件系统访问——路径/glob 归一、扫描结果到记录的建记录与对账、补丁与计划的归一核对、模块边推导、确定性 Markdown 渲染、git 降级探测都在这里，任何写盘（锁内编排 + 原子写）都不在本文件。它被 lib/core.mjs 以 desc.* 整体消费、被 bin/flow.mjs 的 `desc plan --template` 懒加载；依赖方向固定 core → desc → source-scan/util，本模块不得 import core。",
  "modules": [
    {
      "id": "section-1",
      "title": "常量",
      "semantics": "spec §1/§2 的硬编码默认与形状约束（语义下限 10 字符、模块 id 与任务 id 正则、文件/模块 op 集合、import kind 集合、默认 include/exclude、模块边 why 的上限）。用途是契约 description 节缺省时兜底，保证每个纯函数单独调用也自洽；有契约值时以契约为准，这里只是下限防呆。",
      "members": [
        "SCHEMA",
        "MODULE_ID_RE",
        "MODULE_ID_MAX",
        "MIN_SEMANTICS_CHARS",
        "DEFAULT_MAX_FILES",
        "DEFAULT_MAX_SCAN_BYTES",
        "WHY_LIMIT",
        "TASK_ID_RE",
        "JS_EXTENSIONS",
        "MODULE_OPS",
        "FILE_OPS",
        "IMPORT_KINDS",
        "LANGUAGES",
        "DEFAULT_INCLUDE",
        "DEFAULT_EXCLUDE"
      ]
    },
    {
      "id": "section-2",
      "title": "通用小工具",
      "semantics": "跨模块共用的无副用小工具：UTF-16 码元序的稳定比较（不用 locale，跨平台一致）、now 的 Date/ISO/毫秒归一、正整数兜底、description 节取值（兼容整份契约与单节）、语义归一（trim + 内部空白折叠）与下限判定、scannedMap/records 的只读索引。它们不抛业务错误，把非法输入折成默认值或 null，是各模块「同口径」的唯一来源。",
      "members": [
        "compareText",
        "isoOf",
        "positiveInt",
        "integerOr",
        "stringListOf",
        "descriptionConfigOf",
        "minSemanticsOf",
        "normalizedSemantics",
        "semanticsLength",
        "hasSemantics",
        "sameSemantics",
        "semanticsField",
        "oneLine",
        "safeNormalizePath",
        "scannedIndexOf",
        "recordIndexOf"
      ]
    },
    {
      "id": "section-3",
      "title": "路径",
      "semantics": "仓库相对 POSIX 路径的唯一出入口：normalizeSourcePath 做 `\\`→`/`、去 `./`、折叠空段，并拒绝绝对路径、`..`、控制字符与 flow store 自身（.dsh/flow）；encodePath/decodePath 是记录文件名键的可逆编解码（段内 `*` 转 `%2A`、段间 `%2F`，解码只收主干）。不变量：记录里的 path 才是真值、文件名只是键，两者不一致视为坏记录。",
      "members": [
        "normalizeSourcePath",
        "encodePath",
        "decodePath"
      ]
    },
    {
      "id": "glob",
      "title": "glob（最小）",
      "semantics": "最小 glob 引擎：`**` 只在整段时匹配零或多段，`*`/`?` 限于段内，其余字符按字面量，先把模式编译成 RegExp 再由 globMatcher 复用；scopeMatcherOf 用 include ∧ ¬exclude 定义「参与描述的文件范围」，是 listSourceFiles 与 checkPlan 共用的同一口径，不允许两处各写一遍。",
      "members": [
        "REGEX_SPECIALS",
        "escapeRegExpChar",
        "segmentRegExp",
        "globToRegExp",
        "globPathOf",
        "globMatcher",
        "scopeMatcherOf"
      ]
    },
    {
      "id": "section-5",
      "title": "只读文件系统",
      "semantics": "只读访问工作树：递归列文件（跳过符号链接与非普通文件、超 maxFiles 截断并告警、按 path 排序）、readSource 在 realpath 上判出根并拒绝符号链接/二进制/超大文件、算 sha256 与行数（末尾换行不多算一行），再把 source-scan 的裸 import 解析成 {specifier,kind,target}——相对 specifier 解析不到时 target 留 null 并保留 raw 供 ghost-import 判定。",
      "members": [
        "absoluteOf",
        "listSourceFiles",
        "countLines",
        "hashOf",
        "readSource",
        "stripSpecifierSuffix",
        "firstExistingFile",
        "resolveJsTarget",
        "resolvePythonTarget",
        "resolveImportTarget",
        "normalizeImports",
        "normalizeLanguage",
        "scanSourceAt"
      ]
    },
    {
      "id": "build",
      "title": "种子模块（build）",
      "semantics": "新记录的结构播种：slugify 把段名折成模块 id（中文段名 slug 为空则回退 section-N，冲突依次 -2/-3 且不超 41 字符），JS 按列首 `// ---- 段名` 切段、Python 按 class 切段（其余顶层归 top-level）、无标记则整文件一个模块。边界：只决定初始分区，已有记录不会被重新播种，人工划分必须保留。",
      "members": [
        "slugify",
        "uniqueModuleId",
        "moduleOf",
        "scanSectionMarkers",
        "baseNameWithoutExtension",
        "seedJsModules",
        "seedPythonModules",
        "seedModules"
      ]
    },
    {
      "id": "section-7",
      "title": "记录播种",
      "semantics": "记录的创建与对账：createRecord 产出结构齐全、semantics 为空串的 schema 1 记录（含按种子成员现算的模块边），reconcileRecord 只同步 hash/bytes/lines/language/imports/moduleEdges，而保留 semantics 与 modules（含已失效成员，留给 check 报 unknown-member）；structuralKey 相同即返回原记录且 changed:false，避免无变化写盘。",
      "members": [
        "declarationsOf",
        "createRecord",
        "normalizeImportsFromScanned",
        "structuralKey",
        "reconcileRecord"
      ]
    },
    {
      "id": "section-8",
      "title": "模块边推导",
      "semantics": "从成员引用推模块边：模块 A 的任一成员在代码里引用了模块 B 的成员即 A→B，count 为去重后的命中对数、why 取前 3 对 `a → b`，边按 (from,to) 排序、自环丢弃；成员名跨模块重复时以先出现的模块为归属，保证同一输入永远得到同一条边表。canonicalEdges 是记录值与现算值比较用的同一形状。",
      "members": [
        "edgeComparator",
        "canonicalEdges",
        "deriveModuleEdges"
      ]
    },
    {
      "id": "set",
      "title": "文件补丁（set）",
      "semantics": "`flow desc set` 的单文件补丁模型：validateFilePatch 校验模块 id 正则、title/semantics 类型与下限、members 去重非空、op 合法性（remove 只收 id，add 必须给 semantics 与非空 members）；applyFilePatch 先删后改地落模块，成员必须真实存在于当前扫描声明（否则 invalid），补丁新造出的跨模块成员重复也拒绝，并按新成员重推 moduleEdges。注意补丁的 members 是整体替换，计划里的才是增量断言。",
      "members": [
        "validateFilePatch",
        "validateModulePatch",
        "memberListOf",
        "normalizeModules",
        "memberOwnersOf",
        "duplicatedMembers",
        "applyFilePatch"
      ]
    },
    {
      "id": "section-10",
      "title": "计划核对",
      "semantics": "计划与记录的逐项对账：planRealization 比较计划要求的语义文本与结构（模块存在性、成员子集），返回未落地项（空数组=完全落地），供 apply 判 applied、check 报 plan-unrealized；它只判「落地没落地」，合法性与覆盖范围交给 checkProject/checkPlan。issue/sortIssues 统一检查项形状（kind/path/module/detail/hint/level）与稳定排序。",
      "members": [
        "issue",
        "sortIssues",
        "planRealization"
      ]
    },
    {
      "id": "section-11",
      "title": "项目检查",
      "semantics": "`check description` 的只读漂移检查：逐条现算 stale-hash、ghost-import、modules-missing、unassigned-member、unknown-member、duplicate-member、empty-module、missing-semantics、invalid-edge、stale-module-edges 与 render-stale，undescribed-file 在非 strict 下只算 warn。不变量：不信 project.counts/revision 这类缓存摘要，一切以现算为准，免得单条写坏被整体指纹掩盖。",
      "members": [
        "checkProject",
        "renderedContentOf"
      ]
    },
    {
      "id": "section-12",
      "title": "计划归一",
      "semantics": "语义变更计划的归一与落地：normalizePlanInput 校验 files 非空 xor noSemanticChange+reason、op 与任务 id 形状，并把计划里模块的 members 定为增量并集语义；applyPlanToRecords 声明式地把语义写进记录（可重复执行，第二次 applied:false，并写 implemented_at），结构性不可能（成员不在当前声明、删除不存在的模块）抛 invalid 而不是默默跳过。",
      "members": [
        "normalizeBase",
        "normalizeHistoryEntry",
        "normalizePlanModule",
        "normalizePlanFile",
        "normalizePlanInput",
        "applyPlanToRecords"
      ]
    },
    {
      "id": "section-13",
      "title": "计划检查",
      "semantics": "阶段门用的计划检查：报 plan-missing/plan-unrealized/unplanned-change，unplanned-change 用 gitProbe + gitChangedFiles 对比 base（git 不可用或 base 失效降级为 warning，不阻断）；requireTests 时以 max(implemented_at, 计划内记录 updated_at) 为测试证据起点，早于它的绿记录不算数。",
      "members": [
        "parseTime",
        "testEvidenceFloor",
        "opMatches",
        "checkPlan"
      ]
    },
    {
      "id": "section-14",
      "title": "汇总 / 渲染",
      "semantics": "展示层：summarize 现算 counts（missingSemantics 按待填单元计——文件 1 + 每模块 1，described 只数达标的文件），renderMarkdown 按 spec §10 骨架输出确定性 Markdown（文件按 path、模块按记录顺序、边按 (from,to)，Mermaid 节点用序号、标签转义）。刻意不含墙钟时间：同 project + records 永远同字节，否则 render --check 会在每次 build 后必然 stale。",
      "members": [
        "summarize",
        "escapeMermaidLabel",
        "tableCell",
        "memberCell",
        "fileGraphLines",
        "moduleGraphLines",
        "renderMarkdown"
      ]
    },
    {
      "id": "git",
      "title": "git",
      "semantics": "降级用 git 探针：runGit 带 GIT_TIMEOUT_MS 超时跑只读命令，gitProbe 返回 {ok,head,reason}（非工作树/无提交/没装 git 都 ok:false），gitChangedFiles 用 diff --name-only 加未跟踪文件给出 add/change/remove 列表。git 不可用一律降级为 warning，是否阻断由调用方决定。",
      "members": [
        "GIT_TIMEOUT_MS",
        "runGit",
        "gitProbe",
        "statusOfGitCode",
        "gitChangedFiles"
      ]
    }
  ],
