        "HEARTBEAT_SESSION_PATTERN",
        "SUBAGENT_ORIGIN"
      ]
    },
    {
      "id": "workspace-inspection",
      "title": "workspace inspection",
      "semantics": "只做异步的台账存在性探测 `hasStoreAsync`：`stat` `<root>/.dsh/flow/flow.json` 并判 isFile，供 HTTP/TUI 在读或写之前区分「未初始化」；任何异常（不存在、无权限、指向目录）都返回 false 且不抛，且不读台账内容。",
      "members": [
        "hasStoreAsync"
      ]
    },
    {
      "id": "workspace-scope",
      "title": "workspace scope",
      "semantics": "工作区注册表与根作用域的唯一实现：`workspacePath` 用纯路径算术规范化注册行（不触盘），`canonicalRoot`/`isDirectory` 对请求根做 realpath 与目录校验，`rootWithin`/`rootAccepted` 要求根等于或位于某注册工作区之内、或自带 flow 台账，`rootName` 决定显示名（`flow.json` 的 name > 最内层注册工作区标题 > 目录名）。不变量：只有被接受的根才会被读或写，注册表每个请求只枚举一次，缺挂载的注册行不产生文件系统调用。",
      "members": [
        "canonicalRoot",
        "isDirectory",
        "workspacePath",
        "listWorkspaces",
        "rootWithin",
        "rootAccepted",
        "rootName"
      ]
    },
    {
      "id": "http",
      "title": "HTTP",
      "semantics": "同源与 JSON 响应封装：`sendJson`/`sendError` 统一输出 `application/json; charset=utf-8`、`cache-control: no-store`、content-length 以及 `{ok:false,error:{code,message}}` 形状；`originAllowed` 仅在请求带 Origin 头时要求它等于 `webServer.getOrigin()`，无 Origin（非浏览器客户端）放行，取不到期望 origin 则拒绝。",
      "members": [
        "sendJson",
        "sendError",
        "originAllowed"
      ]
    },
    {
      "id": "state-read-isolation",
      "title": "state read isolation",
      "semantics": "把阻塞式快照读取隔离到 per-`apply` 的 fork 工作池（`StateWorkerPool`：1800ms 读取 deadline、4000ms ready 超时、空闲 unref、stdio ignore、env 白名单、一请求独占一个 child），`handleState` 只做方法/同源/单根作用域校验并转发；worker 超时、崩溃、池已销毁统一成 `state-timeout` / `state-worker-crashed` / `state-worker-unavailable` 的 `ok:false`，因此宿主事件循环从不同步读 store。",
      "members": [
        "STATE_DEADLINE_MS",
        "STATE_READY_MS",
        "STATE_MAX_IDLE",
        "STATE_MAX_CHILDREN",
        "stateMaxChildren",
        "STATE_WORKER_DEFAULT_SCRIPT",
        "stateWorkerScript",
        "stateWorkerEnv",
        "STATE_POOLS",
        "statePoolOf",
        "StateWorkerPool",
        "requestStateSnapshot",
        "handleState"
      ]
    },
    {
      "id": "p3a-read-only-team-board",
      "title": "P3a: read-only team board",
      "semantics": "只读 Team 看板投影：Team 服务以 live Agent 作授权凭据，故 `TEAM_CALLERS`（按 ctx 的 WeakMap）只记住最后一个主会话 agent，无凭据或服务时输出 `available:false`（面板隐藏该行而不是报 0）；`applyTeamBoard` 只在快照 fork 之后用内存中的 Team 数据做链接对账，`collectPanelState` 是 HTTP 响应与 TUI 共用的唯一投影（含 not-initialized、agents 标注、心跳过滤），`panelStateReader` 是它在 TUI 侧不抛错的包装。",
      "members": [
        "TEAM_UNAVAILABLE",
        "TEAM_CALLERS",
        "teamCallerState",
        "rememberTeamCaller",
        "teamCallerOf",
        "teamStatusFor",
        "applyTeamBoard",
        "collectPanelState",
        "panelStateReader"
      ]
    },
    {
      "id": "init-http",
      "title": "init HTTP",
      "semantics": "init 写路由：`readBody` 以 8KB 为界读 JSON，超限立即 `tooLarge` 并在后台排空剩余字节（不让响应等流）；`handleInit` 依次校验 POST、同源、JSON body、root 是已存在目录且通过根作用域，然后把目录交给 `lib/core.mjs` 的 `initProject` 落盘，conflict 映射 409，created/warnings 各截断到 50/20，并用 `already-initialized:` 前缀判定重复初始化。",
      "members": [
        "readBody",
        "handleInit"
      ]
    },
    {
      "id": "gate-http",
      "title": "gate HTTP",
      "semantics": "gate 写路由：与 init 共享 POST、同源、8KB body、根作用域四道门，额外要求 `id` 非空、`enabled` 为布尔且该根已有台账，最后只经 `lib/core.mjs` 的 `loadContract` + `updateGate` 翻转一个门禁定义；响应仅回显 `{id, enabled}`，不暴露台账其余内容。",
      "members": [
        "handleGate"
      ]
    },
    {
      "id": "heartbeats",
      "title": "heartbeats",
      "semantics": "会话心跳、捕获与每轮提醒的宿主侧主体：从 `exec.agent.id` / `DSH_SESSION_ID` 取 session，读可选 `agents` 服务的 live 证据（live 覆盖 6h 超时但绝不复活 core 判定的 dead），用 `roots()`/`origin` 区分主会话与子代理，在 agent/created 自动开心跳（空栈用占位 goal）、turn-stopping 续期并排空捕获队列、agent/disposed 关闭仍 open 的心跳，同时产出受 800 字符总预算约束的每轮提醒（命令回显 → 当前任务 → 待决策，超预算按整行从尾部丢弃）与常驻纪律段。不变量：hook 路径永不抛，子代理不建心跳，捕获永不创建心跳，stale 行必须在 agents 标注之后才允许过滤。",
