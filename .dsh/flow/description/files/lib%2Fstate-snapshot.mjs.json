  "lines": 1372,
  "semantics": "只读快照模块：既可作为宿主 fork 出来的隔离 worker（PF_STATE_WORKER=1）响应 snapshot/ping IPC，也可被 import 作纯函数库（buildSnapshot），把 store、契约、任务、门禁、心跳与决策投影成有界、可序列化的面板 payload。它不做任何写操作、不 import 宿主，core 经动态 import 可选加载，realpath memo 只在单次请求内存在；宿主 index.js、lib/plugin/* 与 lib/tools/* 依赖它，边界是「只读 + 有界降级」。",
  "modules": [
    {
      "id": "top",
      "title": "常量与上限",
      "semantics": "文件级不可变常量：payload 字节/条目/字符串与任务行、树深、趋势窗口上限，实验六态，legacy 告警去重集合，以及 .dsh/flow/flow.json 契约路径；下游所有裁剪与告警文本都引用这里，改值即改对外 payload 形状。",
      "members": [
        "LIB_ROOT",
        "CORE_URL",
        "GIT_TIMEOUT_MS",
        "GIT_MAX_BUFFER",
        "MAX_STRING",
        "MAX_PAYLOAD_BYTES",
        "MAX_STORE_ITEMS",
        "MAX_DRAFT_TASKS",
        "MAX_TASK_ROWS",
        "MAX_TASK_DEPTH",
        "MAX_TASK_ITEM",
        "EXPERIMENT_STATUS_SIX",
        "MAX_TREND_DAYS",
        "TREND_DEFAULT_DAYS",
        "DAY_MS",
        "LEGACY_EXPERIMENTS_WARNED",
        "MAX_TASK_LIST",
        "STORE_CONTRACT"
      ]
    },
    {
      "id": "core-module",
      "title": "core 加载",
      "semantics": "动态加载 lib/core.mjs 并暴露 coreAvailable/requireCore/takeCoreWarnings 等探针：core 存在时是唯一 store 读取入口，加载失败则降级为 core-unavailable 告警与可操作错误，绝不让插件加载整体失败，也不复制 core 的逻辑。",
      "members": [
        "core",
        "coreFailure",
        "takeCoreWarnings",
        "coreModule",
        "coreUnavailableMessage",
        "coreAvailable",
        "requireCore"
      ]
    },
    {
      "id": "primitives",
      "title": "基础工具",
      "semantics": "无状态基础工具：把时间戳格式化为带本地偏移的 ISO 字符串、把任意错误/字符串裁剪成有界告警片段，并提供 isPlainObject/splitLines/toPosix 等纯函数；不读盘、不抛错，是其余投影逐字段兜底的第一层。",
      "members": [
        "isoLocal",
        "clip",
        "errorText",
        "brief",
        "isPlainObject",
        "splitLines",
        "toPosix"
      ]
    },
    {
      "id": "path-containment",
      "title": "路径包含",
      "semantics": "root-relative 路径容纳校验的镜像实现：拒绝绝对路径与 .. 逃逸，并用请求级 memo 的 realpath 复核符号链接，非法值不抛错而是隐藏并写入调用方 warnings；刻意不 import lib/paths.mjs 以保持告警汇独立，供 tasks.current 等 manifest 路径复核。",
      "members": [
        "rejectManifestPath",
        "pathWithin",
        "memoizedRealpath",
        "realPathStaysInside",
        "containedPath",
        "git"
      ]
    },
    {
      "id": "contract",
      "title": "契约读取",
      "semantics": "读取展示与边界参数：readManifestName 异步从 flow.json 取项目名（失败回退目录名）、storeContractPath 拼路径、pickInteger 夹取数字选项；只做读取与夹取，不校验 contract 语义。",
      "members": [
        "pickInteger",
        "readManifestName",
        "storeContractPath"
      ]
    },
    {
      "id": "head",
      "title": "HEAD 采集",
      "semantics": "用只读 git 命令（rev-parse/log/status）采集 HEAD 短 sha、subject、branch 与 dirty，单项失败只追加 warnings 并留 null；git 在 worker 子进程里执行，超时也只让本次快照降级，不阻塞宿主事件循环。",
      "members": [
        "readHead"
      ]
    },
    {
      "id": "tasks",
      "title": "任务行投影",
      "semantics": "任务记录到面板行的投影：FIFO 按 created_at 排序、父链深度封顶 3，scope/acceptance/commits 等列表按 MAX_TASK_LIST 与 MAX_TASK_ITEM 裁剪，acceptance 兼容 {cmd,expect} 旧形状；只读派生，不写台账。",
      "members": [
        "timeValue",
        "lastCheckpointGate",
        "clipTaskList",
        "clipTaskAcceptance",
        "clipTaskScope",
        "taskStageOf",
        "panelTaskRow"
      ]
    },
    {
      "id": "heartbeats",
      "title": "心跳投影",
      "semantics": "把 core 的富心跳项投影成面板行（补 title/statusLine），并按 liveness 与 ageSeconds 判定可见性：live 永远可见，dead/stale 隐藏，未知状态仅 6 小时内可见；heartbeatRowVisible 由宿主在 applyAgentLiveness 后复用同一规则。",
      "members": [
        "panelHeartbeat",
        "panelHeartbeats",
        "heartbeatRowVisible"
      ]
    },
    {
      "id": "decisions",
      "title": "决策投影",
      "semantics": "按固定 11 键顺序投影决策行（丢弃 turnAge/rationale/affects/fingerprint 等不应进浏览器的字段），并把计数归一为七个固定键；core 未返回 decisions 时用 summarizeDecisions 重建，异常降级为空结构。",
      "members": [
        "DECISION_ITEM_KEYS",
        "panelDecisionOption",
        "panelDecision",
        "panelDecisions",
        "decisionSection"
      ]
    },
    {
      "id": "payload",
      "title": "payload 组装",
      "semantics": "组装完整 store payload 并负责有界化：合并契约/store/任务/门禁/心跳/决策/趋势，超 900KB 时逐条裁剪实验并同步剪枝树，必要时把 warnings 截到 20 条；契约或 store 读取失败时返回空 payload 加告警，进入时丢弃 core 诊断日志以免轮询污染下一次工具输出。",
      "members": [
        "pruneTree",
        "capPayload",
        "taskCountsOf",
        "createdOrder",
        "taskParentOf",
        "taskDepthIndex",
        "queueHeadId",
        "activeTasksOf",
        "draftTasksOf",
        "recentDoneOf",
        "teamLinksOf",
        "isControlTask",
        "controlOf",
        "stageCountsOf",
        "stageRowsOf",
        "emptyStageCounts",
        "emptyStages",
        "emptyStoreState",
        "buildStoreState",
        "localDayNumber",
        "localDayKey",
        "trendTimestamp",
        "deriveTrend",
        "experimentsEnabled",
        "legacyExperimentsWarning",
        "experimentCountsOf",
        "buildState",
        "decisionRemindMax",
        "DECISION_COUNT_KEYS",
        "decisionCountsOf",
        "emptyDecisionCounts"
      ]
    },
    {
      "id": "snapshot-api",
      "title": "快照接口",
      "semantics": "buildSnapshot 是快照唯一出口：按请求构造 root/realRoot 与 per-request realpath memo，调用 buildState 后序列化一次用 capPayload 裁到上限，返回宿主可直接发送的普通对象；memo 绝不跨请求或跨进程传递。",
      "members": [
        "buildSnapshot"
      ]
    },
    {
      "id": "worker-entry",
      "title": "worker 入口",
      "semantics": "fork 子进程入口：PF_STATE_WORKER=1 时启动 IPC 循环，先发 ready，再逐条处理 ping 与 snapshot 请求、回一条 JSON reply；channel 断开或未捕获异常直接 exit，stdout/stderr 不产生输出，被 import 时不启动。",
      "members": [
        "IS_WORKER",
        "workerReply",
        "startWorker"
      ]
    }
  ],
