  "semantics": "project-flow 的唯一 CLI 入口（package.json 的 bin 字段），由 skills 与测试以子进程方式调用：解析 argv、按命令分派、格式化人类/--json 输出，并把错误映射成 0/1/2/3/4 退出码。它不直接读写 .dsh/flow 台账——存储、校验与门禁执行全部懒加载委托 lib/core.mjs（脚本检查另走 lib/checks.mjs）——因此台账语义变更应落在 core/desc，而不是这个文件。",
  "modules": [
    {
      "id": "top",
      "title": "top",
      "semantics": "CLI 的静态契约层：保存 USAGE 帮助文本、两套退出码映射，以及 BOOL/VALUE/REPEAT 三类 flag 全集和按（命令,子命令）声明的 SPEC 白名单；assertFlagsAllowed 在任何 core 读写之前拒绝未声明的 flag，使不支持参数不可能触达写路径。",
      "members": [
        "USAGE",
        "EXIT",
        "EXIT_BY_CODE",
        "CHECK_EXIT_BY_CODE",
        "STATUS_HEARTBEAT_ROWS",
        "BOOL_FLAGS",
        "VALUE_FLAGS",
        "REPEAT_FLAGS",
        "SPEC",
        "GLOBAL_FLAGS",
        "specOfSpec",
        "describeFlags",
        "assertFlagsAllowed",
        "CliError"
      ]
    },
    {
      "id": "section-1",
      "title": "参数解析",
      "semantics": "把原始 argv 拆成 flags、repeated 与 positional：支持 --k=v 与 --k v、把 -h 归一成 help，并按 BOOL/VALUE/REPEAT 集合校验取值；未知参数与缺值只记入 errors 不立即抛，由 main 统一按 usage 失败。",
      "members": [
        "parseArgv"
      ]
    },
    {
      "id": "section-2",
      "title": "输出工具",
      "semantics": "终端与 --json 输出的共享原语：stdout/stderr 写入、JSON 信封、按 CJK 双宽计算的对齐/截断/表格，以及时间与耗时格式化；只在人类输出路径使用，其中 pad 与 lib/util.mjs 的同名函数语义不同、不可合并。",
      "members": [
        "jsonMode",
        "topCommand",
        "out",
        "errOut",
        "emitJson",
        "charWidth",
        "textWidth",
        "pad",
        "clip",
