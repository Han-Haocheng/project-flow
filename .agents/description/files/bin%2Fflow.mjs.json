        "TASK_TITLE_REVIEW_WIDTH",
        "plannedTaskTitle",
        "displayWidthOf",
        "runTaskNormalize"
      ]
    },
    {
      "id": "section-13",
      "title": "展示辅助",
      "semantics": "命令的人类输出辅助：printRecord/printGate/printRun/printGatePhaseRun/printTree 负责记录、门禁、运行、phase 批运行与树形结构的排版；confirmDelete 负责 rm 前确认（--yes 可跳过；--json 或非 TTY 必须显式 --yes，绝不隐式删除）。",
      "members": [
        "printRecord",
        "printGate",
        "printRun",
        "printGatePhaseRun",
        "printTree",
        "confirmDelete"
      ]
    },
    {
      "id": "section-14",
      "title": "入口",
      "semantics": "进程入口：懒加载 core 与 team-sync（缺模块时给可操作的 io 错误），把 show/update/rm 等子命令的位置参数归一到 flags.id、按命令分派到各 cmd*，并在成功/失败两条路径统一收集 warnings、把 CliError 与检查载荷映射成 0/1/2/3/4 退出码。",
      "members": [
