  "lines": 1040,
  "semantics": "零第三方依赖的启发式源码扫描器：按扩展名把源码文本解析成 import 边（static/side-effect/dynamic/reexport）与顶层声明（name/kind/exported/startLine/endLine/identifiers），供 lib/desc.mjs 经 core 的 build/check 路径做成员归属与模块边推导。它只认识文本、不认识项目，不读盘不写盘，唯一依赖是 util.mjs 的 FlowError；已知漏扫（解构、匿名默认导出等）按「漏 = 不归属、不假红」处理。",
  "modules": [
    {
      "id": "top",
      "title": "词法常量",
      "semantics": "扫描器的词法常量与字符判定：JS/Python 扩展名集合、标识符/空白判定、语句前缀、正则前缀与 JS/PY 噪声词；它们共同定义「什么算声明、import 或成员引用」，本身不遍历结构。",
      "members": [
        "JS_EXTENSIONS",
        "SPACE",
        "DIGIT",
        "IDENT_START",
        "IDENT_PART",
        "STATEMENT_PREFIX",
        "REGEX_PREFIX",
        "JS_NOISE",
        "PY_NOISE",
        "isIdentStart",
        "isIdentPart",
        "isSpace"
      ]
    },
    {
      "id": "section-1",
      "title": "公开接口",
      "semantics": "冻结的公开入口：languageOf 只按扩展名返回 js/python/null，scanSource 在 text 非字符串时抛 FlowError(invalid) 后分派 JS/Python 扫描，未知语言返回 language:'unknown' 且 imports/declarations 为空（不猜结构）。",
      "members": [
        "languageOf",
        "scanSource"
      ]
    },
    {
      "id": "section-2",
      "title": "通用词法工具",
      "semantics": "与语言无关的词法工具：剥注释、跳字符串/模板插值/正则、把片段替换为等长空白、计算行起点与在掩码文本上收集标识符；不变量是掩码与剥注释都不改变字符偏移，因此行号和声明区间可回映原文。",
      "members": [
        "extensionOf",
        "readWord",
        "skipSpace",
        "skipString",
        "skipTemplateExpression",
        "blank",
        "startsRegex",
        "skipRegex",
        "regexAt",
        "stripComments",
        "mask",
        "computeLineStarts",
        "lineOf",
        "trimEnd",
        "collectIdentifiers"
      ]
    },
    {
      "id": "js-ts",
      "title": "JS / TS 侧",
      "semantics": "JS/TS/JSX 顶层扫描：以括号深度 0 加语句起点判定 function/class/const|let|var（含 async/export/default 前缀与本地 export {…} 清单），收 import、export-from 与字面量 dynamic import 边；解构声明与匿名默认导出按已知局限跳过而不报假红。",
      "members": [
        "isStatementStart",
        "statementStartOf",
        "isExported",
        "readJsDeclaration",
        "scanJsImports",
        "isDynamicImportSite",
        "readDynamicImport",
        "readImportClause",
        "readExportFrom",
        "readLocalExportList",
        "scanJsDeclarations",
        "finishJsDeclarations"
      ]
    },
    {
      "id": "python",
      "title": "Python",
      "semantics": "Python 扫描：先用等长掩码去掉 # 注释与单/双/三引号字符串，再按列首收 def/async def/class 与顶层 NAME= 赋值（exported = 名字不以 _ 开头），只记顶层 import/from…import；块边界按缩进回 0 判定，函数内延迟导入不计边。",
      "members": [
        "maskPython",
        "skipPyString",
        "splitLines",
        "leadingWidth",
        "scanPythonImports",
        "scanPythonDeclarations"
      ]
    }
  ],
