  "semantics": "project-flow 的宿主入口（装配层）：声明 inject=['webServer'] 并 apply 一次装配——把读/写路由交给 lib/host/state.mjs 与 lib/host/routes.mjs，把工具、技能、系统提示、会话钩子与权限面交给 lib/host/* 的对应模块；本文件只做装配与 mountJsonRoute，不含业务实现。",
  "modules": [
    {
      "id": "top",
      "title": "top",
      "semantics": "入口依赖与常量：inject=['webServer']（TUI 宿主无 webServer 时本入口保持 pending，子插件仍可用），以及从 lib/host/* 引入的装配符号。",
      "members": [
        "inject"
      ]
    },
    {
      "id": "tools",
      "title": "tools",
      "semantics": "装配：mountJsonRoute 把一条路由挂到 webServer（effect 内注册、卸载即注销）；apply 依次建 state 池、挂三条路由、注册工具/技能/提示/提醒/心跳钩子，并用 sessionHooks 注入 restrict 与 team caller 记忆。",
      "members": [
        "mountJsonRoute",
        "apply"
      ]
    }
  ],
