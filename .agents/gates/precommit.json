{
  "id": "precommit",
  "title": "提交前暂存区检查",
  "phase": "commit",
  "enabled": true,
  "steps": [
    {
      "id": "whitespace",
      "run": "git diff --cached --check",
      "expect": "exit 0",
      "timeoutSeconds": 600
    },
    {
      "id": "decisions",
      "run": "\"./bin/flow.mjs\" check decisions",
      "expect": "exit 0",
      "timeoutSeconds": 600
    },
    {
      "id": "tasks-archive",
      "run": "\"./bin/flow.mjs\" task archive",
      "expect": "exit 0",
      "timeoutSeconds": 600
    },
    {
      "id": "tasks-format",
      "run": "\"./bin/flow.mjs\" check tasks",
      "expect": "exit 0",
      "timeoutSeconds": 600
    },
    {
      "id": "description",
      "run": "\"./bin/flow.mjs\" check description",
      "expect": "exit 0",
      "timeoutSeconds": 600
    },
    {
      "id": "commit-scope",
      "run": "node scripts/commit-scope.mjs",
      "expect": "exit 0",
      "timeoutSeconds": 600
    },
    {
      "id": "module-domain",
      "run": "node scripts/module-domain.mjs verify",
      "expect": "exit 0",
      "timeoutSeconds": 600
    },
    {
      "id": "tests",
      "run": "node --test test/",
      "expect": "exit 0",
      "timeoutSeconds": 600
    }
  ],
  "schema": 1,
  "created_at": "2026-10-29T11:46:55+08:00",
  "updated_at": "2026-11-08T13:21:14+08:00"
}
